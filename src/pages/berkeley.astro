---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import Layout from '@/layouts/Layout.astro'

const links = [
  {
    href: 'https://eecstime.sethw.dev',
    title: 'EECSTime',
    description: 'Find courses and plan your schedule with ease.',
  },
  {
    href: 'https://berkeley-intros.sethw.dev',
    title: 'Berkeley Intros',
    description: 'Find who at Berkeley you share interests with.',
  },
]
---

<Layout title="Berkeley" description="Tools and links for Berkeley students.">
  <Container class="flex flex-col items-center gap-y-6">
    <div class="w-full max-w-[400px]">
      <Breadcrumbs
        items={[{ label: 'Berkeley', icon: 'lucide:graduation-cap' }]}
      />
    </div>

    <section class="flex w-full max-w-[400px] flex-col gap-y-4">
      <h1 class="text-2xl font-semibold tracking-tight">
        For Berkeley students
      </h1>
      <p class="text-base text-muted-foreground">
        A couple of things I've built that might be useful.
      </p>

      <ul class="not-prose flex flex-col pt-2">
        {
          links.map((link) => (
            <li>
              <Link
                href={link.href}
                external
                class="group flex items-center justify-between gap-3 border-b border-border py-4 transition-colors last:border-b-0"
              >
                <span class="flex flex-col gap-0.5">
                  <span class="text-base font-medium text-foreground">
                    {link.title}
                  </span>
                  <span class="text-sm text-muted-foreground">
                    {link.description}
                  </span>
                  <span class="text-xs text-muted-foreground/80">
                    {link.href.replace('https://', '')}
                  </span>
                </span>
                <span class="text-muted-foreground transition-transform group-hover:translate-x-0.5">
                  &rarr;
                </span>
              </Link>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>
