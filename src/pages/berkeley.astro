---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import Link from '@/components/Link.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout title="Berkeley" description="Tools and links for Berkeley students.">
  <Container class="flex flex-col items-center gap-y-6">
    <div class="w-full max-w-[400px]">
      <Breadcrumbs
        items={[{ label: 'Berkeley', icon: 'lucide:graduation-cap' }]}
      />
    </div>

    <section class="flex w-full max-w-[400px] flex-col gap-y-4">
      <h1 class="text-2xl font-semibold tracking-tight">
        For Berkeley students
      </h1>
      <p class="text-base text-muted-foreground">
        A couple of things I've built that might be useful.
      </p>

      <ul class="not-prose flex flex-col pt-2">
        <li class="border-b border-border py-4">
          <Link
            href="https://eecstime.sethw.dev"
            external
            class="group flex items-center justify-between gap-3"
          >
            <span class="text-base font-medium text-foreground">EECSTime</span>
            <span
              class="text-muted-foreground transition-transform group-hover:translate-x-0.5"
            >
              &rarr;
            </span>
          </Link>
          <p class="pt-0.5 text-sm text-muted-foreground">
            Find courses and plan your schedule with ease. Full list of
            improvements from Berkeleytime{' '}
            <Link
              href="https://github.com/mr-mph/eecstime/blob/main/README.md"
              external
              underline
              class="text-foreground"
            >
              here
            </Link>.
          </p>
          <span class="text-xs text-muted-foreground/80">
            eecstime.sethw.dev
          </span>
        </li>
        <li class="py-4">
          <Link
            href="https://berkeley-intros.sethw.dev"
            external
            class="group flex items-center justify-between gap-3"
          >
            <span class="text-base font-medium text-foreground"
              >Berkeley Intros</span
            >
            <span
              class="text-muted-foreground transition-transform group-hover:translate-x-0.5"
            >
              &rarr;
            </span>
          </Link>
          <p class="pt-0.5 text-sm text-muted-foreground">
            Find who at Berkeley you share interests with. Built from the
            #introduce-yourself channels of UC Berkeley discords.
          </p>
          <span class="text-xs text-muted-foreground/80">
            berkeley-intros.sethw.dev
          </span>
        </li>
      </ul>
    </section>
  </Container>
</Layout>
